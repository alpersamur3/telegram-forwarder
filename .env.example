# ── Telegram API credentials ──────────────────────────────────────────────────
# Get from https://my.telegram.org/apps
API_ID=123456
API_HASH=your_api_hash_here

# ── Mode ──────────────────────────────────────────────────────────────────────
# BOT_TOKEN: Leave EMPTY for userbot (recommended — reads channels without admin)
# Fill it in to run as a regular bot (bot must be added as member to all chats)
BOT_TOKEN=

# Session file name (no extension needed)
SESSION_NAME=forwarder_session

# ── Admin control ─────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs that can issue commands (leave empty = everyone)
ADMIN_IDS=123456789,987654321

# ── Anti-ban settings ─────────────────────────────────────────────────────────
# Max messages to forward per time window
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_SECONDS=60
# Delay (seconds) between each individual forward
FORWARD_DELAY=0.5

# "copy"    → sends as a new message (no "Forwarded from" label)
# "forward" → uses Telegram native forward (shows source channel)
FORWARD_MODE=copy

# ── Content filtering (Whitelisting & Blacklisting) ───────────────────────────
# Whitelist: Comma-separated list of allowed content types (empty = all allowed)
# Options: text, photo, video, document, audio, voice, video_note, sticker, animation, poll, location, contact, venue, game
ALLOWED_MEDIA_TYPES=

# Blacklist: Comma-separated list of blocked content types (empty = none blocked)
BLOCKED_MEDIA_TYPES=

# ── Service message forwarding (Anti-noise) ───────────────────────────────────
# True  → converts service messages (new member, pinned, topic open/close/create) to custom text notifications and forwards them
# False → completely ignores/filters out all service messages (default, recommended to prevent errors)
FORWARD_SERVICE_MESSAGES=False
